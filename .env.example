
# Delivery prefix for stored file keys. The upload API returns a relative key
# (nous/dev/<uuid>.png) and records keep only that, so the browser needs this to
# show an avatar or open a PDF. Cloudinary serves both images and PDFs from the
# image/upload path.
VITE_MEDIA_BASE_URL=https://res.cloudinary.com/jbsp2dd6/image/upload
